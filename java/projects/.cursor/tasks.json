{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mvn: Producer (spring-boot:run)",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run", "-pl", "kafka-producer-api", "-am"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "mvn: Consumer (spring-boot:run)",
      "type": "shell",
      "command": "mvn",
      "args": ["spring-boot:run", "-pl", "kafka-consumer-api", "-am"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "mvn: clean install",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "install", "-DskipTests"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
